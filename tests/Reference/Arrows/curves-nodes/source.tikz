\usetikzlibrary{arrows.meta}%
\begin{tikzpicture}
\draw[-{Stealth}] (0,0) .. controls (1,0) and (2,.5) .. (2,1);
\draw[{Latex}-{Stealth}] (0,1.5) .. controls (0,2.5) and (2,2.5) .. (2,1.5);
\draw[-{Latex}] (0,3) .. controls (1,3) and (2,3) .. (2,3);
\draw[-{Stealth}] (0,3.5) .. controls (1,3.5) and (2,4) .. (2,4);
\draw[-{Latex}] (0,4.5) .. controls (0,4.5) and (0,4.5) .. (2,4.5);
\draw[-{Stealth}] (0,5) to[bend left=25] (2,5);
\node[draw,minimum width=12pt,minimum height=12pt,inner sep=0pt] (left) at (0,6) {};
\node[draw,circle,minimum size=14pt,inner sep=0pt] (right) at (2,6) {};
\draw[-{Stealth}] (left) -- (right);
\draw[-{Latex},shorten >=1pt] (left) to[bend left=25] (right);
\path[draw,red] (0,7) edge[blue,-{Stealth},bend left=20] (2,7) -- (2,7);
\end{tikzpicture}
