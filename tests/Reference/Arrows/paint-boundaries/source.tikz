\usetikzlibrary{arrows.meta}%
\begin{tikzpicture}
\draw[-{Stealth},dashed,blue,line cap=round,line join=bevel] (0,0) -- (2,0);
\draw[-{Latex},draw=red,fill=blue,opacity=.4] (0,.5) -- (2,.5);
\draw[->,draw=blue,line cap=butt,line join=miter] (0,1) -- (2,1);
\begin{scope}
\clip (0,1.3) rectangle (1.8,2.2);
\draw[-{Stealth},green!50!black] (0,1.5) -- (2,1.5);
\draw[-{Latex},dotted] (0,2) -- (2,2);
\end{scope}
\draw[-{Stealth}] (0,2.5) -- (1,2.5) -- (1,3) -- cycle;
\draw[-{Latex}] (0,3.5) -- (1,3.5) (1.5,3.5) -- (2.5,3.5);
\draw[-{Stealth}] (0,4) -- (0,4);
\draw[->,line cap=round] (1,4) -- (1,4);
\draw[-{Latex}] (2,4);
\draw[-{Stealth}] (0,4.5) -- (1,4.5) (1.5,4.5) -- (2,4.5) -- (2,5) -- cycle;
\draw[-{Stealth}] (0,5.5) -- (2,5.5);
\end{tikzpicture}
