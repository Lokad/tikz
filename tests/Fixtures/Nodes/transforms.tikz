\begin{tikzpicture}
  \node[draw,line width=1.4pt] (plain) at (0pt,0pt) {AV ffi.};
  \begin{scope}[shift={(30pt,40pt)},rotate=30,xscale=1.5,yscale=.75]
    \node[draw] (upright) at (0pt,0pt) {AV ffi.};
    \node[draw,transform shape] (inherited) at (50pt,0pt) {AV ffi.};
    \node[draw,rotate=15] (local-rotation) at (0pt,35pt) {Ag.};
  \end{scope}
  \begin{scope}[shift={(165pt,40pt)},xscale=-1.2,yscale=.8]
    \node[draw,transform shape] (reflected) at (0pt,0pt) {AV ffi.};
  \end{scope}
  \node[draw,node font=\large,font=\normalsize,xshift=1em]
    (font-shift) at (0pt,90pt) {AV ffi.};
  \begin{scope}[cm={1,.3,.4,1,(90pt,95pt)}]
    \node[draw,line width=2pt,transform shape] (sheared) at (0pt,0pt) {AV ffi.};
  \end{scope}
  \coordinate (start) at (upright.north);
  \coordinate (end) at (inherited.south);
  \draw[blue] (start) -- (end);
\end{tikzpicture}
