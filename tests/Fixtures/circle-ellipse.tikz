\begin{tikzpicture}[x=8mm,y=5mm,scale=1.25]
  \coordinate (start) at (0,0);
  \coordinate (end) at (3,1);
  \draw[blue,line width=1pt] (start) circle[radius=1] -- +(1.5,0);
  \filldraw[draw=red,fill=yellow,line width=.6pt,fill opacity=.4]
    (end) ellipse[x radius=.8,y radius=.5];
  \draw[green!50!black,line width=1pt] (3,-1) circle (3mm);
\end{tikzpicture}
