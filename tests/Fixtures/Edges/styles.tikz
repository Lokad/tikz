\begin{tikzpicture}
  \draw[red,line width=1pt] (0pt,0pt) to[blue,line width=2pt] (20pt,0pt) -- (40pt,10pt);
  \draw[red,line width=1pt] (0pt,25pt) edge[blue,line width=2pt] (20pt,35pt) -- (40pt,25pt);
  \fill[red] (0pt,50pt) edge[blue] (20pt,65pt) -- (40pt,50pt) -- (40pt,60pt) --cycle;
  \begin{scope}[every path/.style={line width=1pt},every edge/.style={draw,green,line width=2pt}]
    \draw[red] (0pt,80pt) edge[blue,line cap=round,draw opacity=.4] (20pt,90pt) -- (40pt,80pt);
  \end{scope}
  \begin{scope}[every edge/.style={}]
    \draw[red] (0pt,105pt) edge[blue] (20pt,120pt) -- (40pt,105pt);
  \end{scope}
  \begin{scope}[every to/.style={red,line width=2pt,xshift=5pt}]
    \draw[blue,line width=1pt] (0pt,135pt) to (20pt,135pt) -- ++(20pt,0pt);
  \end{scope}
  \begin{scope}[every path/.style={draw=green},every edge/.style={fill=yellow}]
    \path (0pt,160pt) edge[blue] (20pt,170pt) -- (40pt,160pt);
  \end{scope}
  \draw[red,line width=1pt,dash pattern=on 3pt off 2pt,dash phase=1pt] (0pt,190pt) edge[blue,line width=2pt] (40pt,205pt) -- (40pt,190pt);
  \draw[red,line width=1pt,dotted,line cap=round] (0pt,220pt) edge[blue,solid,line cap=rect,line join=bevel] (40pt,235pt) -- (40pt,220pt);
  \filldraw[fill=yellow,draw=red,opacity=.6] (0pt,250pt) edge[draw=blue,fill=green,fill opacity=.3] (20pt,260pt) -- (40pt,250pt) -- (40pt,260pt) --cycle;
  \draw[red] (0pt,280pt) edge[blue][line width=2pt][draw opacity=.5] (40pt,290pt) -- (40pt,280pt);
  \draw[red] (0pt,310pt) edge[draw=none] (20pt,325pt) -- (40pt,310pt);
\end{tikzpicture}
