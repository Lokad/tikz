\begin{tikzpicture}[x=20pt,y=15pt]
  \draw (0,0) to[xshift=5pt] ++(1,0) -- ++(1,0);
  \draw (0,2) to[xshift=5pt] (1,2) -- ++(1,0);
  \draw (0,4) edge[xshift=5pt] +(1,1) -- ++(1,0);
  \draw (0,6) edge[x=40pt] +(1,1) -- ++(1,0);
  \draw (0,8) edge[x=40pt] (1,9) -- ++(1,0);
  \draw (0,10) to[x=40pt] +(1,1) -- ++(1,0);
  \coordinate (target) at (3,12);
  \draw (0,12) edge[xshift=5pt] (target) to[yshift=5pt] (target) -- ++(1,0);
  \draw (0,14) to ++(30:1) edge ++(-30:1) -- ++(1,0);
  \begin{scope}[xshift=90pt,rotate=30,scale=1.2]
    \draw (0,0) edge[red,rotate=15] (1,1) to[xshift=5pt] (2,0) -- ++(1,0);
  \end{scope}
  \begin{scope}[xshift=100pt,yshift=60pt,xscale=-1,yscale=.7]
    \draw (0,0) to (2,1) edge[blue,xshift=5pt] +(1,1) -- ++(1,0);
  \end{scope}
  \begin{scope}[cm={1,.25,.4,1,(100pt,120pt)}]
    \draw (0,0) edge[red,yshift=5pt] (2,1) to ++(1,0) -- ++(1,1);
  \end{scope}
\end{tikzpicture}
