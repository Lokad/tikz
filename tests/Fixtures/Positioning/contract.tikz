\usetikzlibrary{positioning,calc}
\begin{tikzpicture}[every node/.style={draw,rectangle,minimum width=10mm,minimum height=7mm,inner sep=2pt}]
  \node (seed) {A};
  \node[above=of seed] (north) {N};
  \node[below=of seed] (south) {S};
  \node[right=of seed] (east) {E};
  \node[left=of seed] (west) {W};
  \node[above right=of seed] (northeast) {NE};
  \node[above left=of seed] (northwest) {NW};
  \node[below right=of seed] (southeast) {SE};
  \node[below left=of seed] (southwest) {SW};
  \node[below right=12mm of south] (single) {One};
  \node[above left=5mm and 9mm of west] (two) {Two};
  \node[right=5mm of east.north] (anchorTarget) {Anchor};
  \coordinate (waypoint) at ($(south)!0.5!(southeast)+(0,-8mm)$);
  \node[below=3mm of waypoint] (coordinateTarget) {Point};
  \tikzset{node distance=9mm}
  \begin{scope}[node distance=4mm]
    \node[above=of north] (scopedDistance) {Scope};
  \end{scope}
  \node[above=of scopedDistance] (restoredDistance) {Restore};
  \begin{scope}[x={(4mm,1mm)},y={(-1mm,3mm)}]
    \node[below right=2 and 3 of two] (basisPair) {Basis};
    \node[above left=2 of two] (basisSingle) {Single};
  \end{scope}
  \begin{scope}[xscale=1.3,yscale=0.7,rotate=17,shift={(40mm,-24mm)}]
    \node (resetSeed) {Reset};
    \node[right=6mm of resetSeed] (reset) {World};
    \node[transform shape,below=7mm of resetSeed] (full) {Full};
    \node[right=5mm of full,scale=1.2,xshift=2mm] (localOrder) {Local};
  \end{scope}
  \node[below=of southwest,node distance=2mm] (captureDistance) {Capture};
  \node[right=-3mm of southeast] (negativeDistance) {Negative};
  \tikzset{neighbor/.style={above=8mm of northeast,inner sep=3pt}}
  \node[neighbor] (styled) {Style};
\end{tikzpicture}
