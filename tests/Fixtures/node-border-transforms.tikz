\begin{tikzpicture}[every node/.style={draw,inner sep=0pt,minimum width=10pt,minimum height=8pt,outer sep=.3pt}]
  \coordinate (start) at (-20pt,-20pt);
  \coordinate (end) at (95pt,55pt);
  \node[rotate=27] (a) at (0pt,0pt) {};
  \node[cm={1,.3,.4,.9,(0pt,0pt)}] (b) at (40pt,15pt) {};
  \begin{scope}[shift={(65pt,30pt)},rotate=41,xscale=1.2,yscale=.8]
    \node[transform shape] (c) at (0pt,0pt) {};
    \node (d) at (25pt,0pt) {};
    \draw (c) -- (d);
  \end{scope}
  \draw (a) -- (b) -- (c) -- (d);
  \draw (a) -| (b);
  \draw (a) |- (b);
  \draw (b) .. controls (40pt,45pt) and (75pt,55pt) .. (c);
  \begin{scope}[cm={1.2,.1,.3,.9,(3pt,5pt)}]
    \draw (a) -- (b);
    \draw (a) -| (c);
  \end{scope}
\end{tikzpicture}
