\begin{tikzpicture}[every node/.style={draw,inner sep=0pt,minimum width=10pt,minimum height=8pt,outer sep=.3pt}]
  \coordinate (start) at (-20pt,-20pt);
  \coordinate (end) at (70pt,30pt);
  \node (a) at (0pt,0pt) {};
  \node[minimum width=13pt,minimum height=11pt,outer xsep=1pt,outer ysep=2pt] (b) at (40pt,15pt) {};
  \node[minimum width=8pt,minimum height=12pt] (c) at (65pt,-15pt) {};
  \draw (a) -- (b) -- (c) -- (a);
  \draw (-20pt,-10pt) -- (a) -- (10pt,25pt);
  \draw (a.center) -- (b.center);
  \draw (a.east) -- (70pt,0pt);
  \draw (a) -- +(15pt,-20pt) -- ++(15pt,0pt);
  \draw (a) -- (a);
  \draw (a) -- (1000sp,0sp);
  \draw (a) -- (2000sp,0sp);
  \draw (a) -- (2039sp,0sp);
  \draw (a) -- (2040sp,0sp);
  \draw (b) (a) -- (15pt,30pt);
\end{tikzpicture}
