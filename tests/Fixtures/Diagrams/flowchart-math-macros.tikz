\usetikzlibrary{positioning,arrows.meta,calc}
\begin{tikzpicture}[node distance=9mm,
  box/.style={draw,rectangle,minimum width=#1,inner sep=3pt},
  stage/.style={box=#1},stage/.append style={minimum height=8mm}]
  \pgfmathsetmacro\step{(3+1)/2}
  \pgfmathsetmacro\dy{-(2+1)/2}
  \node[box=12mm] (input) {Input};
  \foreach \i in {1,...,3} {
    \pgfmathsetmacro\offset{\i*\dy}
    \coordinate (row\i) at ($(input)+(\step*1cm,\offset*1cm)$);
    \node[stage=14mm] (stage\i) at (row\i) {Stage \i};
  }
  \node[box=18mm,right={\step*5mm} of stage2] (output) {Output};
  \draw[-{Stealth}] (input) -- node[midway,above] {read} (stage2);
  \foreach \i in {1,2,3} {
    \draw[-{Stealth}] (stage\i.east) -- node[midway,above] {send \i} (output);
  }
  \pgfmathsetmacro\factor{1/2}
  \coordinate (split) at ($(stage1)!\factor!(stage3)$);
  \pgfmathsetmacro\returny{4*\dy}
  \coordinate (return) at ($(input.south)+(0,\returny*1cm)$);
  \draw[-{Stealth}] (stage3.west) -| (return) -- (input.south);
\end{tikzpicture}
