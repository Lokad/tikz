* text=auto eol=lf
*.tikz text eol=lf
*.tex text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.pdf binary
*.png binary
*.gz binary
*.tfm binary
# Keep independently generated SVGs and sanitized oracle logs byte-identical.
tests/Reference/*/reference.svg -text whitespace=cr-at-eol
tests/Reference/*/oracle.log -text -whitespace
# Native diagnostic traces retain spacing but use portable LF serialization.
tests/Reference/Text/*/native-positions.log text eol=lf -whitespace
tests/Reference/Nodes/rectangles/reference.svg -text whitespace=cr-at-eol
tests/Reference/Nodes/rectangles/oracle.log -text -whitespace
tests/Reference/Nodes/rectangles/native-positions.log text eol=lf -whitespace
tests/Reference/NodeInteractions/*/reference.svg -text whitespace=cr-at-eol
tests/Reference/NodeInteractions/*/oracle.log -text -whitespace
tests/Reference/NodeInteractions/*/native-positions.log text eol=lf -whitespace
tests/Reference/NodeInteractionsRgb/*/reference.svg -text whitespace=cr-at-eol
tests/Reference/NodeInteractionsRgb/*/oracle.log -text -whitespace
tests/Reference/NodeInteractionsRgb/*/native-positions.log text eol=lf -whitespace
tests/Reference/NodeShapes/native/*reference.svg -text whitespace=cr-at-eol
tests/Reference/NodeShapes/native/*oracle.log -text -whitespace
tests/Reference/NodeShapes/native/native-positions.log text eol=lf -whitespace
tests/Reference/NodeShapes/pdf/*.log -text -whitespace
tests/Reference/LabelledBorders/*/*reference.svg -text whitespace=cr-at-eol
tests/Reference/LabelledBorders/*/*.log text eol=lf -whitespace
tests/Reference/Edges/*/*reference.svg -text whitespace=cr-at-eol
tests/Reference/Edges/*/*.log text eol=lf -whitespace
tests/Reference/Dashes/native/*reference.svg -text whitespace=cr-at-eol
tests/Reference/Dashes/native/*.log -text -whitespace
tests/Reference/DashGeometry/native/*reference.svg -text whitespace=cr-at-eol
tests/Reference/DashGeometry/native/*.log -text -whitespace
# Upstream license texts are retained byte for byte, including line endings.
licenses/Fonts/GUST-FONT-LICENSE.txt -text -whitespace
licenses/Fonts/LPPL-1.3c.txt -text -whitespace
licenses/Fonts/README-Latin-Modern.txt -text -whitespace
licenses/Fonts/MANIFEST-Latin-Modern.txt -text -whitespace
